# Copy to server/.env for local development.
# On Railway these are set as service variables instead -- and
# DATABASE_URL is injected automatically once you add a Postgres
# service, so you do not set that one by hand there.

# Local Postgres. On Railway this is provided for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paddlepad

# Signs login tokens. MUST be random and at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value in production than locally, and never commit
# the real one -- anyone holding it can forge a login for any umpire.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Comma-separated list of origins allowed to call this API.
# Defaults to local Vite dev if unset. Set this to the deployed app's
# URL in Railway.
CORS_ORIGIN=http://localhost:5173
