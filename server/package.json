{
  "name": "paddlepad-umpire-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "test:e2e": "node scripts/e2e.mjs",
    "test:serving": "node scripts/check-serving.mjs",
    "test:board": "node scripts/check-board.mjs",
    "test:playstyle": "node scripts/check-playstyle.mjs",
    "test:rating-parts": "node scripts/check-rating-parts.mjs",
    "test:expectation": "node scripts/check-expectation.mjs",
    "test:third-shot": "node scripts/check-third-shot.mjs",
    "test:rally-endings": "node scripts/check-rally-endings.mjs",
    "test:rally-rating": "node scripts/check-rally-rating.mjs",
    "test:rally-rating-store": "node scripts/check-rally-rating-store.mjs",
    "check:partner": "node scripts/check-partner.mjs",
    "test:db:up": "docker compose -f ../docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f ../docker-compose.test.yml down -v"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  }
}
