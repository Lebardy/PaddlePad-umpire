# Copy to .env.local for local development.
#
# Vite inlines VITE_* variables at BUILD time, so they are public --
# only non-secret values belong here.

# Where the API is. Defaults to http://localhost:3000 if unset.
# Set to the deployed Railway API URL for production builds.
VITE_API_URL=http://localhost:3000

# Google sign-in. The OAuth client ID from Google Cloud Console --
# public by design, and inert without this app's origin listed in that
# client's authorized JavaScript origins.
#
# Leave it unset and the Google button simply does not render; the code
# and password ways in are untouched.
VITE_GOOGLE_CLIENT_ID=
