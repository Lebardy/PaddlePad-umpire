# Copy to .env.local for local development (Vite reads .env.local and
# it is already gitignored).
#
# Vite inlines VITE_* variables into the built JavaScript at build
# time, so they are PUBLIC -- anyone can read them in the shipped
# bundle. Only put non-secret values here. The API base URL is fine;
# never put JWT_SECRET or a database password in this file.

# Where the Express server in server/ is running.
# Defaults to http://localhost:3000 if unset.
# Set this to the deployed Railway API URL for production builds.
VITE_API_URL=http://localhost:3000
