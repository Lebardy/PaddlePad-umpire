# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python, for the ML service in ml/
.venv
__pycache__/
*.pyc

# Secrets -- never commit. Contains the database password and the
# JWT_SECRET that signs umpire logins; anyone holding the latter can
# forge a login as any umpire. Only .env.example belongs in git.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Database dumps from scripts/backup-data.mjs. These contain umpire
# password hashes and player CLAIM CODES, which are bearer credentials
# -- anyone holding one can sign in as that player. One was committed
# once already; never again.
paddlepad-backup.json
*-backup.json

# Written by the rating scripts in server/scripts: which matches were used
# to build and to test, and the synthetic pool's hidden abilities.
server/scripts/.rating-split.json
server/scripts/.sim-pool-truth.json
server/scripts/.rally-points.json
